PORT=5000

# JWT_SECRET must be a cryptographically random string.
# Generate one with:
#   node -e "require('crypto').randomBytes(32).toString('hex')"
# Paste the output here. Do NOT use a guessable value or the placeholder below.
# The server will refuse to start if this key is missing or set to a known placeholder.
JWT_SECRET=generate-a-real-secret-do-not-use-this-value

JWT_EXPIRES_IN=30d

# Optional. If unset, FinTrack tries local MongoDB, then a file-backed fallback.
# MONGODB_URI=mongodb://127.0.0.1:27017/fintrack
